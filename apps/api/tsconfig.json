{
  "compilerOptions": {
    "target": "ES2022",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": false,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node"],

    "rootDir": "src",
    "outDir": "dist",

    "sourceMap": true
  },

  "include": [
    "src/**/*.ts"
, "../web/src/utils/conversions.ts"  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}